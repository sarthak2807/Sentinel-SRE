# ---- Nebius Token Factory -------------------------------------------------
# Create a key at https://tokenfactory.nebius.com -> API keys
NEBIUS_API_KEY=your-nebius-api-key-here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Three-tier Nemotron routing. Nano triages every anomaly cheaply;
# Super/Ultra only wake up for anomalies Nano marks as real.
NEMOTRON_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEMOTRON_SUPER=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_ULTRA=nvidia/Llama-3_1-Nemotron-Ultra-253B-v1

# Embeddings for the incident memory (RAG)
NEBIUS_EMBED_MODEL=Qwen/Qwen3-Embedding-8B

# ---- Sandboxed remediation (Token Factory Sandboxes / Contree) -------------
SANDBOX_MODE=local
NEBIUS_AI_PROJECT=

# ---- Wiring ---------------------------------------------------------------
SENTINEL_PORT=8080
SAMPLE_SERVICE_URL=http://127.0.0.1:8000
SENTINEL_DB=sentinel.db

# Never execute a fix without a human clicking Approve.
AUTO_APPROVE=false

# If the API key is missing, Sentinel falls back to a scripted local model so
# the demo still runs offline. Set to false to hard-fail instead.
ALLOW_OFFLINE_FALLBACK=true

# ---- External sources (read-only) -----------------------------------------
# Link Sentinel to a real AWS account. It only READS CloudWatch (metrics + error
# logs) and never calls a mutating API - incidents from here are diagnosed and
# shown as advisories, never auto-remediated.
SENTINEL_AWS_ENABLED=false
# mock = replay a realistic latency/5xx spike with no credentials (great for demos).
# live = real boto3 against the account below.
SENTINEL_AWS_MODE=mock
AWS_REGION=us-east-1
SENTINEL_AWS_POLL_SECONDS=20
# live mode uses the standard boto3 credential chain (env vars / AWS_PROFILE / IAM role).
# Grant a READ-ONLY policy: CloudWatchReadOnlyAccess + logs:FilterLogEvents.
# Metrics: comma-separated  Namespace:Metric:Stat:Label:AsName[:Dim=Val;Dim=Val]
SENTINEL_AWS_METRICS=AWS/ApplicationELB:TargetResponseTime:Average:prod-alb:latency_ms,AWS/ApplicationELB:HTTPCode_Target_5XX_Count:Sum:prod-alb:http_5xx
# Log groups to scan for ERROR/WARN lines (comma-separated).
SENTINEL_AWS_LOG_GROUPS=/aws/ecs/prod-web
